<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: non-www -> www (301) — zhoda s <link rel="canonical">, robots.txt a sitemap.xml.
  # Bez redirectu vracali oba varianty 200 (duplicate content, SEO audit high finding).
  RewriteCond %{HTTP_HOST} ^redblue\.sk$ [NC]
  RewriteRule ^(.*)$ https://www.redblue.sk/$1 [R=301,L]

  # Allow existing files/folders through
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # SPA fallback
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HSTS — 1 rok vratane subdomen. Preload zatial nezapiname (nevratny commitment do browser preload listu).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # COEP je bezpecny, kym su vsetky zdroje first-party (aktualne ano — ziadne CDN/fonty/embedy).
  # Pri pridani cross-origin obsahu (YouTube, mapy) treba COEP zmenit/odstranit, inak sa nenacita.
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  # style-src 'unsafe-inline': React inline style atributy. JSON-LD <script> je inertny data blok — CSP ho neblokuje.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>
